{
  "name": "my-life-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsup src/server/index.ts --format esm --out-dir dist/server --platform node --target node22 && node scripts/copy-migrations.mjs",
    "start": "node dist/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "package": "node scripts/package-app.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/react-query": "^5.0.0",
    "archiver": "^7.0.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.0.0",
    "fastify": "^5.0.0",
    "lucide-react": "^0.468.0",
    "mime-types": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^3.0.0",
    "tailwind-merge": "^2.5.0",
    "yauzl": "^3.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/archiver": "^6.0.0",
    "@types/mime-types": "^2.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^2.10.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
